# ─────────────────────────────────────────────────────────────
#  Ghostty — reload with cmd+shift+, · validate with `ghostty +validate-config`
#  Full reference: `ghostty +show-config --default --docs | less`
# ─────────────────────────────────────────────────────────────

# ─── Theme ───────────────────────────────────────────────────
theme = TokyoNight Night

# Selection / cursor pulled from the Tokyo Night palette so they
# don't inherit muddy defaults.
selection-background = #2e3c64
selection-foreground = #c0caf5
cursor-color         = #c0caf5
cursor-text          = #1a1b26

# ─── Font ────────────────────────────────────────────────────
font-family        = JetBrainsMono Nerd Font
font-family-bold   = JetBrainsMono Nerd Font
font-family-italic = JetBrainsMono Nerd Font
font-size          = 14
font-thicken       = true

# Breathing room between lines — the single biggest readability win.
adjust-cell-height = 14%

# Ligatures are on by default. Uncomment to kill them:
# font-feature = -calt
# font-feature = -liga

# ─── Window chrome ───────────────────────────────────────────
# Generous padding is what separates "nice" from "default".
window-padding-x       = 16
window-padding-y       = 16
window-padding-balance = true
window-padding-color   = background

macos-titlebar-style = tabs
# Fully chromeless alternative (you lose the drag area — cmd+drag
# still moves the window on macOS):
# macos-titlebar-style = hidden

window-height = 46
window-width  = 180

# Translucent + blurred background. Set opacity to 1 if you want
# zero transparency, or drop blur to 0 for a flat look.
background-opacity   = 0.94
background-blur      = 24
unfocused-split-opacity = 0.88

# ─── Cursor ──────────────────────────────────────────────────
cursor-style             = bar
cursor-style-blink       = true
mouse-hide-while-typing  = true

# ─── Behavior ────────────────────────────────────────────────
copy-on-select           = clipboard
confirm-close-surface    = false
window-save-state        = always
scrollback-limit         = 100000
shell-integration        = zsh
shell-integration-features = cursor,sudo,title

# Makes option behave as Alt so M-b / M-f / M-hjkl reach zsh and tmux.
macos-option-as-alt = true

# Kill the audible bell; flash the window instead.
# (Remove `attention` if you don't want the dock bounce.)
bell-features = system,attention

# ─── Quick terminal ──────────────────────────────────────────
# Quake-style dropdown from anywhere in macOS. Grant Accessibility
# permission the first time it's used.
quick-terminal-position           = top
quick-terminal-animation-duration = 0.15
keybind = global:cmd+grave_accent=toggle_quick_terminal

# ─── Keybinds ────────────────────────────────────────────────
# All Cmd-based, so nothing here collides with tmux's C-a prefix.
# tmux owns the day-to-day splitting; these make Ghostty's native
# splits usable when you want a throwaway pane outside a session.

# Splits — iTerm-style
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+shift+enter=toggle_split_zoom

# Navigate splits
keybind = cmd+bracket_left=goto_split:previous
keybind = cmd+bracket_right=goto_split:next

# Resize splits
keybind = cmd+ctrl+left=resize_split:left,30
keybind = cmd+ctrl+right=resize_split:right,30
keybind = cmd+ctrl+up=resize_split:up,30
keybind = cmd+ctrl+down=resize_split:down,30
keybind = cmd+alt+equal=equalize_splits

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+bracket_left=previous_tab
keybind = cmd+shift+bracket_right=next_tab

# Font size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Misc
keybind = cmd+k=clear_screen
keybind = cmd+shift+r=reload_config
